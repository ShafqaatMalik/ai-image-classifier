# Environment variables for Spotify API
# Get these from https://developer.spotify.com/dashboard/applications

# Your Spotify App Client ID
SPOTIFY_CLIENT_ID=your_client_id_here

# Your Spotify App Client Secret  
SPOTIFY_CLIENT_SECRET=your_client_secret_here

# Your Spotify Redirect URI (must match what's configured in your Spotify app)
SPOTIFY_REDIRECT_URI=http://localhost:8080/callback

# Your Spotify Username (for getting user-specific data)
SPOTIFY_USERNAME=your_username_here